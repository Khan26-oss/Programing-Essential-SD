size(800, 400);
background(255); 
stroke(0);       
strokeWeight(2); 
noFill();        
int x = 120;
int y = 130;
String naam = "Bobo";
circle(x, y, 200);             
circle(x - 30, y - 20, 30);   
circle(x + 30, y - 20, 30);   
arc(x, y + 20, 80, 40, 0, PI);       
arc(x - 30, y - 60, 40, 20, PI, 2*PI); 
arc(x + 30, y - 60, 40, 20, PI, 2*PI); 
fill(0);
text("Ik ben " + naam + " en ik sta op x " + x + " en y " + y, x - 90, y + 120);
noFill();
x += 250; 
naam = "Fien";
